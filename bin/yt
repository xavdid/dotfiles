#!/usr/bin/env bash

set -euo pipefail

# Downloads a youtube video in mp4 format and puts it in the archive.
# Or, with -n/--now, onto the desktop (to be watched now)

if [ $# -eq 0 ]; then
  echo "Usage: yt [--now|-n] [--cookies] <video_url>"
  exit 1
fi

require-variables DROPBOX || exit 1

# Defaults
OUTPUT_DIR="$DROPBOX/Archive/Videos/Youtube Backup/%(title)s.%(ext)s"
VIDEO_URL=""
COOKIES_ARGS=()

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --now|-n)
      OUTPUT_DIR="$HOME/Desktop/%(title)s.%(ext)s"
      shift
      ;;

    --cookies)
      COOKIES_ARGS=(--cookies-from-browser firefox)
      shift
      ;;

    -*)
      echo "Unknown option: $1"
      exit 1
      ;;

    *)
      VIDEO_URL="$1"
      shift
      ;;
  esac
done

if [ -z "$VIDEO_URL" ]; then
  echo "Error: Missing video URL"
  exit 1
fi

# avoid AI upscaling
# see: https://github.com/yt-dlp/yt-dlp/issues/15325#issuecomment-3652366533
yt-dlp \
  -t mp4 \
  -f 'bv*[format_id!*=-sr]+ba/b[format_id!*=-sr]' \
  "${COOKIES_ARGS[@]}" \
  -o "$OUTPUT_DIR" \
  "$VIDEO_URL"
